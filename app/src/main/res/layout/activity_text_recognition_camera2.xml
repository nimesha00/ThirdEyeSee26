<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/te_background"
    tools:context=".TextRecognitionCameraActivity2">

    <androidx.camera.view.PreviewView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <TextView
        style="@style/Widget.ThirdEye.ScreenLabel"
        android:layout_margin="16dp"
        android:fitsSystemWindows="true"
        android:text="@string/ocr_title" />

    <!-- Capture: a large yellow button along the bottom edge, easy to find by touch. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/imageButton"
        style="@style/Widget.ThirdEye.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:contentDescription="@string/ocr_capture_description"
        android:text="@string/ocr_capture"
        app:icon="@drawable/ic_camera"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="32dp" />

</FrameLayout>
