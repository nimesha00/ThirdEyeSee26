<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/te_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".TextRecognitionResultActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="12dp"
        android:accessibilityHeading="true"
        android:text="@string/ocr_result_title"
        android:textAppearance="@style/TextAppearance.ThirdEye.Title" />

    <ScrollView
        android:id="@+id/idscrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The recognised text comes first: it's what the user came for. -->
            <EditText
                android:id="@+id/recognizedTextEt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="top|start"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minHeight="120dp"
                android:padding="18dp"
                android:textAppearance="@style/TextAppearance.ThirdEye.Body"
                android:textColorHint="@color/te_text_secondary"
                tools:ignore="LabelFor"
                tools:text="Recognised text appears here." />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imageIv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/take_photo"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_baseline_image_24"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.ThirdEye.Rounded"
                app:strokeColor="@color/te_stroke"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckagain"
        style="@style/Widget.ThirdEye.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_marginTop="16dp"
        android:text="@string/ocr_check_again"
        app:icon="@drawable/ic_camera"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconSize="30dp" />

</LinearLayout>
