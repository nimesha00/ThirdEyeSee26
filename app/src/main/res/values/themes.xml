<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        One high-contrast dark theme in both day and night mode: the app's users rely on
        predictable contrast, so it should not change with the phone's light/dark setting.
        No action bar; each screen shows its own header.
    -->
    <style name="Theme.ThirdEye" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/te_accent</item>
        <item name="colorPrimaryVariant">@color/te_accent_pressed</item>
        <item name="colorOnPrimary">@color/te_on_accent</item>
        <item name="colorSecondary">@color/te_accent</item>
        <item name="colorSecondaryVariant">@color/te_accent_pressed</item>
        <item name="colorOnSecondary">@color/te_on_accent</item>
        <item name="colorSurface">@color/te_surface</item>
        <item name="colorOnSurface">@color/te_text_primary</item>
        <item name="colorError">@color/te_error</item>
        <item name="android:colorBackground">@color/te_background</item>
        <item name="android:windowBackground">@color/te_background</item>
        <item name="android:textColorPrimary">@color/te_text_primary</item>
        <item name="android:textColorSecondary">@color/te_text_secondary</item>
        <item name="android:statusBarColor">@color/te_background</item>
        <item name="android:navigationBarColor">@color/te_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="ShapeAppearance.ThirdEye.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Large header text at the top of a screen. -->
    <style name="TextAppearance.ThirdEye.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/te_text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ThirdEye.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/te_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.ThirdEye.Caption" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/te_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- The main yellow call to action: speak, take photo, check again. -->
    <style name="Widget.ThirdEye.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">72dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/te_on_accent</item>
        <item name="backgroundTint">@color/te_accent</item>
        <item name="iconTint">@color/te_on_accent</item>
        <item name="cornerRadius">24dp</item>
        <item name="rippleColor">#33000000</item>
    </style>

    <!-- Shortcut tile on the home screen: dark card, yellow icon, white label. -->
    <style name="Widget.ThirdEye.Tile" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">88dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">@color/te_text_primary</item>
        <item name="backgroundTint">@color/te_surface</item>
        <item name="strokeColor">@color/te_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">36dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconTint">@color/te_accent</item>
        <item name="rippleColor">#33FFD600</item>
    </style>

    <!-- Round dark button for closing a full-screen camera view. -->
    <style name="Widget.ThirdEye.IconButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">28dp</item>
        <item name="iconTint">@color/te_text_primary</item>
        <item name="backgroundTint">@color/te_scrim</item>
        <item name="cornerRadius">28dp</item>
    </style>

    <!-- Yellow pill label at the top of camera screens ("Note reader", "Live detection"). -->
    <style name="Widget.ThirdEye.ScreenLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_pill_accent</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/te_on_accent</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:accessibilityHeading" tools:targetApi="p">true</item>
    </style>
</resources>
